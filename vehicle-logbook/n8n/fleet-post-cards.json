{
  "id": "FleetPostCards01",
  "name": "Fleet — Post Trip Cards (logbook)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 20 * * *" } ] } },
      "id": "p-sched",
      "name": "Щовечора 20:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id AS trip_id,\n       to_char(t.started_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Moncton','DD.MM HH24:MI') AS start_local,\n       to_char(t.ended_at   AT TIME ZONE 'UTC' AT TIME ZONE 'America/Moncton','HH24:MI')       AS end_local,\n       t.distance_km, t.origin_address, t.destination_address,\n       t.review_reason,\n       (SELECT chat_id FROM fleet.drivers WHERE role='owner' AND active LIMIT 1) AS chat_id\nFROM fleet.trips t\nWHERE t.classification = 'unclassified'\n  AND t.telegram_message_id IS NULL\n  AND t.started_at > now() - interval '7 days'\nORDER BY t.started_at\nLIMIT 20;",
        "options": {}
      },
      "id": "p-query",
      "name": "Некласифіковані",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [40, 300],
      "alwaysOutputData": false,
      "credentials": { "postgres": { "id": "fleetdbfleetrw01", "name": "Fleet DB (fleet_rw)" } }
    },
    {
      "parameters": {
        "jsCode": "// Текст картки. Коротко: водій читає це з телефона за кермом або одразу після.\nreturn $input.all().map(i => {\n  const t = i.json;\n  const km = Number(t.distance_km).toFixed(1);\n  const lines = [\n    `🚐 <b>${t.start_local} → ${t.end_local}</b> · ${km} км`,\n    `${t.origin_address} → ${t.destination_address}`\n  ];\n  if (t.review_reason) lines.push(`⚠️ ${t.review_reason}`);\n  return { json: { ...t, card_text: lines.join('\\n') } };\n});"
      },
      "id": "p-build",
      "name": "Текст картки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.card_text }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            { "row": { "buttons": [
              { "text": "Оцінка/замір", "additionalFields": { "callback_data": "=c:{{ $json.trip_id }}:est" } },
              { "text": "Обʼєкт у роботі", "additionalFields": { "callback_data": "=c:{{ $json.trip_id }}:job" } }
            ] } },
            { "row": { "buttons": [
              { "text": "Постачальник", "additionalFields": { "callback_data": "=c:{{ $json.trip_id }}:sup" } },
              { "text": "Особисте", "additionalFields": { "callback_data": "=c:{{ $json.trip_id }}:per" } }
            ] } }
          ]
        },
        "additionalFields": { "parse_mode": "HTML", "appendAttribution": false }
      },
      "id": "p-send",
      "name": "Надіслати картку",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 300],
      "credentials": { "telegramApi": { "id": "fleettelegrambot1", "name": "ROTES Logbook Bot" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE fleet.trips SET telegram_message_id = $1 WHERE id = $2;",
        "options": { "queryReplacement": "={{ $json.result.message_id }},{{ $('Текст картки').item.json.trip_id }}" }
      },
      "id": "p-save",
      "name": "Запамʼятати message_id",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [700, 300],
      "credentials": { "postgres": { "id": "fleetdbfleetrw01", "name": "Fleet DB (fleet_rw)" } }
    }
  ],
  "connections": {
    "Щовечора 20:00":  { "main": [[{ "node": "Некласифіковані", "type": "main", "index": 0 }]] },
    "Некласифіковані": { "main": [[{ "node": "Текст картки", "type": "main", "index": 0 }]] },
    "Текст картки":    { "main": [[{ "node": "Надіслати картку", "type": "main", "index": 0 }]] },
    "Надіслати картку":{ "main": [[{ "node": "Запамʼятати message_id", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "FleetErrorHandl1" },
  "active": false
}
